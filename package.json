{
  "name": "youpu",
  "version": "0.2.1-beta.6",
  "description": "基于 Electron 的桌面音乐播放器",
  "author": "兜兜里有糖",
  "private": false,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,electron \"npm run server:dev\" \"electron-vite dev\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "dev:electron": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icon": "node scripts/build-icon.mjs",
    "server:install": "npm install --prefix server --ignore-scripts",
    "server:dev": "cross-env NODE_OPTIONS=\"--require ${INIT_CWD}/scripts/netease-dns-preload.cjs --dns-result-order=ipv4first\" NPM_CONFIG_FETCH_TIMEOUT=5000 NPM_CONFIG_FETCH_RETRIES=0 npm run --prefix server start",
    "dist": "npm run build && npm run pack:modules && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "pack:modules": "node scripts/pack-server-modules.mjs",
    "postinstall": "npm run server:install"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@importantimport/material-color-utilities": "^0.2.1",
    "adm-zip": "^0.5.18",
    "ant-design-vue": "^4.2.6",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.4.1",
    "vue": "3.5.32",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.15.41",
    "@tailwindcss/vite": "4.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.8.0",
    "archiver": "^8.0.0",
    "concurrently": "10.0.3",
    "cross-env": "^10.1.0",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.5.0",
    "eslint-plugin-vue": "10.9.2",
    "png-to-ico": "^3.0.1",
    "prettier": "3.8.4",
    "sass": "^1.100.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "7.3.5",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.5"
  }
}
